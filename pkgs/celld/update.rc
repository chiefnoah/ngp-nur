#!/usr/bin/env rc
flag e +

cd `{dirname $0}

for(tool in awk curl jq nix perl) {
  if(! whatis $tool > /dev/null >[2=1]) {
    echo 'error: required command not found: '$tool >[1=2]
    exit 127
  }
}

file=default.nix
repo=https://github.com/denoland/celld

current=`{awk '
  $1 == "version" {
    gsub(/[";]/, "", $3)
    print $3
    exit
  }
' $file}
latest=`{curl -fsSL https://api.github.com/repos/denoland/celld/releases/latest |
  jq -r '.tag_name | sub("^v"; "")'}

if(! ~ $#current 1 || ! ~ $#latest 1 || ~ $latest null '') {
  echo 'celld: could not determine the current or latest version' >[1=2]
  exit 1
}

if(~ $current $latest) {
  echo 'celld: current ('$current')'
  exit 0
}

current_hashes=`{awk '
  $1 == "hash" {
    gsub(/[";]/, "", $3)
    print $3
  }
' $file}

if(! ~ $#current_hashes 2) {
  echo 'celld: could not determine the current artifact hashes' >[1=2]
  exit 1
}

aarch64_url=$repo/releases/download/v$latest/celld-aarch64-unknown-linux-gnu.gz
x86_64_url=$repo/releases/download/v$latest/celld-x86_64-unknown-linux-gnu.gz
aarch64_hash=`{nix store prefetch-file --json $aarch64_url | jq -r .hash}
x86_64_hash=`{nix store prefetch-file --json $x86_64_url | jq -r .hash}

if(! ~ $#aarch64_hash 1 || ~ $aarch64_hash null '' ||
   ! ~ $#x86_64_hash 1 || ~ $x86_64_hash null '') {
  echo 'celld: could not determine the artifact hashes' >[1=2]
  exit 1
}

echo 'celld: '$current' -> '$latest

perl -0pi -e 'BEGIN { $old = shift; $new = shift } s/\Q$old\E/$new/g' \
  $current $latest $file
perl -0pi -e 'BEGIN { $old = shift; $new = shift } s/\Q$old\E/$new/g' \
  $current_hashes(1) $aarch64_hash $file
perl -0pi -e 'BEGIN { $old = shift; $new = shift } s/\Q$old\E/$new/g' \
  $current_hashes(2) $x86_64_hash $file
