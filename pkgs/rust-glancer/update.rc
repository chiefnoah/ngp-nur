#!/usr/bin/env rc
flag e +

cd `{dirname $0}

for(tool in awk git nix) {
  if(! whatis $tool > /dev/null >[2=1]) {
    echo 'error: required command not found: '$tool >[1=2]
    exit 127
  }
}

file=default.nix
repo=https://github.com/rust-glancer/rust-glancer

current=`{awk '
  $1 == "version" {
    gsub(/[";]/, "", $3)
    print $3
    exit
  }
' $file}
latest_tag=`{git ls-remote --tags --sort=-v:refname $repo.git 'v*' | awk '
  $2 !~ /\^\{\}$/ {
    sub("refs/tags/", "", $2)
    print $2
    exit
  }
'}
latest=`{echo $latest_tag | awk '{ sub("^v", ""); print }'}

if(! ~ $#current 1 || ! ~ $#latest 1 || ~ $latest '') {
  echo 'rust-glancer: could not determine the current or latest version' >[1=2]
  exit 1
}

if(~ $current $latest) {
  echo 'rust-glancer: current ('$current')'
  exit 0
}

echo 'rust-glancer: '$current' -> '$latest

cd ../..
nix run 'nixpkgs#nix-update' -- --flake --version=$latest rust-glancer
