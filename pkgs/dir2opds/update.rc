#!/usr/bin/env rc
flag e +

cd `{dirname $0}

for(tool in awk git nix) {
  if(! whatis $tool > /dev/null >[2=1]) {
    echo 'error: required command not found: '$tool >[1=2]
    exit 127
  }
}

file=default.nix
repo=https://github.com/chiefnoah/dir2opds

current=`{awk '
  $1 == "rev" {
    gsub(/[";]/, "", $3)
    print $3
    exit
  }
' $file}
latest=`{git ls-remote $repo.git HEAD | awk 'NR == 1 { print $1 }'}

if(! ~ $#current 1 || ! ~ $#latest 1) {
  echo 'dir2opds: could not determine the current or latest revision' >[1=2]
  exit 1
}

short_current=`{printf %.7s $current}
if(~ $current $latest) {
  echo 'dir2opds: current ('$short_current^')'
  exit 0
}

short_latest=`{printf %.7s $latest}
echo 'dir2opds: '$short_current' -> '$short_latest

cd ../..
nix run 'nixpkgs#nix-update' -- --flake --version=branch dir2opds
